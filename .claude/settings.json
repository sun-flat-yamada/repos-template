  "enableAllProjectMcpServers": false,
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "./.env.local",
        "./.env.development",
        "./.env.production",
        "./.env.staging",
        "./.env.test"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "proxy.golang.org",
        "sum.golang.org",
        "api.nuget.org",
        "pub.dev"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.azure", "mode": "deny" },
