# ==============================================================================
# Comprehensive .gitignore for Modern Multi-Language Repositories (2026 Standard)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔒 CRITICAL: Secrets, Credentials & Privacy Protection (OWASP / Gitleaks / Zero-Leak)
# ------------------------------------------------------------------------------
# Environment files & Local Configs (NEVER commit tokens or secrets)
.env
.env.*
!.env.example
*.env
.envrc

# Private Keys, Certificates & Cryptographic Credentials
*.pem
*.key
*.priv
*.pkcs12
*.p12
*.pfx
*.asc
id_rsa
id_rsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub
*.crt
*.cer
*.der
*.keystore
*.jks
*.token
*.secret

# Cloud Provider Credentials & API Secret Dumps
credentials.json
client_secret*.json
service-account*.json
service_account*.json
.aws/
.gcp/
.azure/
gcloud/
*.ovpn

# Developer Package & Registry Tokens
.npmrc
.pypirc
.gem/credentials

# ------------------------------------------------------------------------------
# OS-Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# No lib/ or lib64/ here: Dart and many JS/TS packages keep source in lib/.
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
/ENV/
/env/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# Node.js / TypeScript / JavaScript
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
lerna-debug.log*
.next/
/out/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/

# ------------------------------------------------------------------------------
# Rust
# ------------------------------------------------------------------------------
/target/
**/*.rs.bk
# Commit Cargo.lock: `cargo build --locked` (policy C-SBX-02) needs it.

# ------------------------------------------------------------------------------
# Go
# ------------------------------------------------------------------------------
*.exe
*.test
*.prof
*.out
# No /bin/ or /pkg/ here: Dart keeps entry points in bin/ and Go code often
# lives in pkg/.

# ------------------------------------------------------------------------------
# Dart / Flutter
# ------------------------------------------------------------------------------
.dart_tool/
.packages
# Commit pubspec.lock: `dart pub get --enforce-lockfile` (policy C-SBX-02) needs it.
build/
.flutter-plugins
.flutter-plugins-dependencies

# ------------------------------------------------------------------------------
# C / C++ / CMake
# ------------------------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
CMakeCache.txt
CMakeFiles/
CMakeScripts/
/Testing/
# No Makefile here: build in build/ (ignored above) so a hand-written root
# Makefile can be committed.
compile_commands.json

# ------------------------------------------------------------------------------
# C# / .NET
# ------------------------------------------------------------------------------
[Bb]in/[Dd]ebug/
[Bb]in/[Rr]elease/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
project.lock.json
.vs/

# ------------------------------------------------------------------------------
# AI Agent Local Cache & Temporary Session Files
# ------------------------------------------------------------------------------
# Share the team permission policy (.claude/settings.json + hooks) and the
# project skills, subagents, and commands; keep personal overrides
# (.claude/settings.local.json) and session data local.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
!.claude/agents/
!.claude/commands/
.gemini_local/
.ai_cache/
*.transcript.jsonl
