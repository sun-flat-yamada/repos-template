{
  "chat.tools.global.autoApprove": false,
  "chat.tools.terminal.enableAutoApprove": true,
  "chat.tools.terminal.ignoreDefaultAutoApproveRules": false,
  "chat.tools.terminal.autoApprove": {
    "/^git (status|diff|log|show|blame)\\b(?!.*--(output|ext-diff|textconv))/": true,
    "/^git\\b.*\\bpush\\b/": false,
    "/^git\\b.*\\b(clone|filter-branch|filter-repo)\\b/": false,
    "/^git\\b.*\\b(reset --hard|clean|restore|checkout --|stash (drop|clear)|branch -D)\\b/": false,
    "/^git\\b.*\\bworktree (remove|rm|move|mv)\\b/": false,
    "/^git\\b.*\\b(remote (add|set-url)|submodule add|config --(global|system))\\b/": false,
    "/--no-verify\\b|core\\.hooks[Pp]ath/": false,
    "/(--dangerously-skip-permissions|--dangerously-bypass-approvals-and-sandbox|--yolo|--trust-all-tools|--allow-all-tools|danger-full-access|bypassPermissions)/": false,
    "/^(sudo|su|doas|pkexec|crontab|launchctl|systemctl)\\b/": false,
    "/^rm\\b.*\\s(-[A-Za-z]*[rR]|--recursive)/": false,
    "/(^|[\\s=\"'])(\\./)?\\.env(\\.(?!example|sample|template)\\S+)?(\\s|$)/": false,
    "/(\\.ssh\\b|\\.aws\\/|\\.azure\\/|\\.kube\\/|\\.gnupg\\/|\\.config\\/gh\\/|\\.git-credentials|\\.netrc|\\.npmrc|\\.pypirc|\\.tfstate|\\.(pem|key|p12|pfx)\\b)/": false,
    "/^(curl|wget|ssh|scp|sftp|rsync|ftp|nc|ncat|netcat|socat|telnet|ping|dig|nslookup|host)\\b/": false,
    "/^(gh|npx|bunx|uvx|pipx|eval|env|printenv|kill|pkill|killall)\\b/": false,
    "/^(npm|pnpm|yarn|bun) (install|i|add|update|upgrade|remove|uninstall|exec|dlx|publish|unpublish|login|token)\\b/": false,
    "/^(pip|pip3|python3? -m pip) (install|uninstall)\\b/": false,
    "/^(uv (add|remove|pip|tool|publish)|poetry (add|remove|update|publish)|twine upload)\\b/": false,
    "/^cargo (add|remove|install|update|publish|yank|login)\\b/": false,
    "/^(go (get|install)|dotnet (add|remove|tool|nuget)|(dart|flutter) pub (add|remove|upgrade|publish|global))\\b/": false,
    "/^(docker|podman|kubectl|helm|terraform|tofu|terragrunt|pulumi|cdk|aws|gcloud|gsutil|az|psql|mysql|mongosh|redis-cli|sqlcmd|ngrok|cloudflared)\\b/": false
  },
  "chat.tools.edits.autoApprove": {
    "**/*": true,
    "**/.env": false,
    "**/.env.*": false,
    "**/*.pem": false,
    "**/*.key": false,
    "**/.vscode/**": false,
    "**/.claude/**": false,
    "**/.cursor/**": false,
    "**/.gemini/**": false,
    "**/.codex/**": false,
    "**/.agents/**": false,
    "**/.github/**": false,
    "**/.githooks/**": false,
    "**/.mcp.json": false,
    "**/.pre-commit-config.yaml": false,
    "**/.gitignore": false,
    "**/CLAUDE.md": false,
    "**/AGENTS.md": false,
    "**/GEMINI.md": false,
    "**/.cursorrules": false,
    "**/package.json": false,
    "**/package-lock.json": false,
    "**/pnpm-lock.yaml": false,
    "**/yarn.lock": false,
    "**/pyproject.toml": false,
    "**/requirements*.txt": false,
    "**/uv.lock": false,
    "**/poetry.lock": false,
    "**/Cargo.toml": false,
    "**/Cargo.lock": false,
    "**/go.mod": false,
    "**/go.sum": false,
    "**/*.csproj": false,
    "**/Directory.Packages.props": false,
    "**/packages.lock.json": false,
    "**/pubspec.yaml": false,
    "**/pubspec.lock": false
  },
  "chat.tools.urls.autoApprove": {
    "https://docs.github.com/*": true,
    "https://docs.python.org/*": true,
    "https://developer.mozilla.org/*": true,
    "https://nodejs.org/*": true,
    "https://www.typescriptlang.org/*": true,
    "https://go.dev/*": true,
    "https://pkg.go.dev/*": true,
    "https://doc.rust-lang.org/*": true,
    "https://docs.rs/*": true,
    "https://learn.microsoft.com/*": true,
    "https://dart.dev/*": true,
    "https://api.dart.dev/*": true,
    "https://en.cppreference.com/*": true,
    "https://code.claude.com/*": true
  },
  "chat.agent.sandbox.enabled": "on",
  "chat.agent.sandbox.allowNetwork": false,
  "chat.agent.allowedNetworkDomains": [
    "registry.npmjs.org",
    "pypi.org",
    "files.pythonhosted.org",
    "crates.io",
    "index.crates.io",
    "static.crates.io",
    "proxy.golang.org",
    "sum.golang.org",
    "api.nuget.org",
    "pub.dev"
  ],
  "chat.agent.deniedNetworkDomains": [
    "169.254.169.254",
    "metadata.google.internal",
    "pastebin.com",
    "webhook.site",
    "transfer.sh",
    "*.ngrok.io",
    "*.ngrok-free.app",
    "*.trycloudflare.com"
  ],
  "chat.useClaudeHooks": true
}
