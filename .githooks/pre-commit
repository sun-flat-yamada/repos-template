#!/usr/bin/env bash
# ==============================================================================
# .githooks/pre-commit
# ==============================================================================
# Checks for:
# 1. Obvious secret patterns (private keys, AWS/GitHub tokens, .env files)
# 2. Template placeholders in staged files (optional warning or block)
# ==============================================================================

set -e

echo "[Hook] Running pre-commit safety checks..."

# 1. Check for staged sensitive files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for FILE in $STAGED_FILES; do
    case "$FILE" in
        *.pem|*.key|id_rsa*|*.pfx|*.p12|service_account*.json)
            echo "❌ [ERROR] Attempting to commit cryptographic secret file: $FILE" >&2
            exit 1
            ;;
        .env|.env.local|.env.production)
            echo "❌ [ERROR] Attempting to commit environment variable file: $FILE" >&2
            exit 1
            ;;
    esac
done

# 2. Check for secret patterns in staged content
if git diff --cached | grep -E -q '(AKIA[0-9A-Z]{16}|ghp_[0-9a-zA-Z]{36}|-----BEGIN (RSA |EC )?PRIVATE KEY-----)'; then
    echo "❌ [ERROR] Potential plain-text API token or private key detected in staged diff!" >&2
    echo "Review your staged changes with: git diff --cached" >&2
    exit 1
fi

# 3. Validate file naming conventions
if command -v python3 >/dev/null 2>&1; then
    python3 scripts/validate-filenames.py --staged
elif command -v python >/dev/null 2>&1; then
    python scripts/validate-filenames.py --staged
fi

echo "✅ [Hook] Pre-commit safety checks passed."
exit 0
